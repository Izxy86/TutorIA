// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  PARENT
}

enum ActivityType {
  LEARNING
  PRACTICE
  HOMEWORK
  EXAM
  REVIEW
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions Interaction[]
  progress     StudentProgress[]
  evaluations  Evaluation[]
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  knowledgeItems KnowledgeItem[]
  interactions   Interaction[]
  progress       StudentProgress[]
}

model KnowledgeItem {
  id        String   @id @default(uuid())
  title     String
  content   String
  topic     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Interaction {
  id           String       @id @default(uuid())
  question     String
  response     String?
  activityType ActivityType
  usedAI       Boolean      @default(false)
  createdAt    DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  evaluation Evaluation?
}

model StudentProgress {
  id             String   @id @default(uuid())
  topic          String
  masteryLevel   Int      @default(0)
  attempts       Int      @default(0)
  correctAnswers Int      @default(0)
  updatedAt      DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId, topic])
}

model Evaluation {
  id               String   @id @default(uuid())
  score            Int?
  isCorrect        Boolean?
  needsHelp        Boolean  @default(false)
  suspectedEvasion Boolean  @default(false)
  feedback         String?
  createdAt        DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  interactionId String      @unique
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
}
